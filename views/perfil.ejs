<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Perfil do Usuário</title>
  <link rel="stylesheet" href="/public/style.css">
  <link rel="icon" href="/public/icon.png" type="icone/png">
  <style>
    .perfil-card {
      max-width: 480px;
      margin: auto;
    }

    .modal {
      display: none;
      position: fixed;
      z-index: 100;
      left: 0; top: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.6);
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background: #ffffff;
      padding: 30px;
      border-radius: 15px;
      text-align: center;
      width: 350px;
    }

    .modal-buttons {
      display: flex;
      gap: 10px;
      margin-top: 20px;
      justify-content: center;
    }
  </style>
</head>
<body>

  <div class="card perfil-card">
    <h2>👤 Meu Perfil</h2>

    <h3>Alterar nome de usuário</h3>
    <form method="POST" action="/update-username">
      <input type="text" name="newUsername" value="<%= user.username %>" required>
      <button class="btn">Salvar</button>
    </form>

    <hr>

    <h3>Alterar senha</h3>
    <form method="POST" action="/update-password">
      <input type="password" name="newPassword" placeholder="Nova senha" required>
      <button class="btn">Alterar senha</button>
    </form>

    <hr>

    <h3>Excluir conta</h3>
    <button class="btn danger" onclick="abrirModal()">Excluir conta</button>

    <a href="/dashboard" class="btn outline" style="margin-top: 15px;">Voltar</a>
  </div>

  <!-- MODAL -->
  <div id="modalExcluir" class="modal">
    <div class="modal-content">
      <h3>Tem certeza?</h3>
      <p>Esta ação não pode ser desfeita.</p>

      <div class="modal-buttons">
        <form method="POST" action="/delete-account">
          <button class="btn danger">Excluir</button>
        </form>

        <button class="btn outline" onclick="fecharModal()">Cancelar</button>
      </div>
    </div>
  </div>

<script>
  function abrirModal() {
    document.getElementById("modalExcluir").style.display = "flex";
  }

  function fecharModal() {
    document.getElementById("modalExcluir").style.display = "none";
  }
</script>

</body>
</html>
